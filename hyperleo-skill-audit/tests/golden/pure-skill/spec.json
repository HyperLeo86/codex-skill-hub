{
  "name": "pure-skill",
  "version": "1.0.0",
  "one_liner": "搜索候选项目并按相关性排序输出",
  "triggers": [
    "帮我找项目",
    "找一下相关开源项目",
    "搜索候选项目",
    "帮我排序候选清单",
    "有哪些项目可以选",
    "找找现成的方案",
    "帮我找项目并排序",
    "搜索一下项目列表"
  ],
  "anti_triggers": [
    "写代码",
    "发布项目"
  ],
  "input_output": {
    "input": "项目搜索需求",
    "output": "候选项目清单",
    "acceptance": [
      "输出按相关性排序",
      "每个候选附来源链接",
      "不修改任何项目"
    ]
  },
  "freedom": "medium",
  "failure_modes": [
    {
      "scenario": "无搜索结果",
      "fallback": "输出空清单并说明"
    },
    {
      "scenario": "链接失效",
      "fallback": "标注待验证"
    },
    {
      "scenario": "输入为空",
      "fallback": "询问需求"
    }
  ],
  "token_budget": {
    "skill_md_lines": 120,
    "skill_md_tokens": 1000
  }
}
